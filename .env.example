# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DATABASE_PATH=./data/social_studio.sqlite

# Redis Configuration (For BullMQ durable queues)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=
# Set USE_IN_MEMORY_REDIS=true if running locally without an external Redis instance
USE_IN_MEMORY_REDIS=true

# Telegram Publisher Configuration (Real Publisher Target)
# Get your bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Target chat_id or channel username (e.g. -1001234567890 or @your_channel)
TELEGRAM_CHAT_ID=

# Mock Publishers Settings
MOCK_X_FAILURE_RATE=0
MOCK_LINKEDIN_FAILURE_RATE=0
